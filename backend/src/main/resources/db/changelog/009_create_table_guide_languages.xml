<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="006" author="mhamed">
        <createTable tableName="guide_languages">

            <column name="language_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="guide_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addPrimaryKey
                tableName="guide_languages"
                columnNames="languages_id,guide_id"
                constraintName="pk_guide_languages"
        />

        <addForeignKeyConstraint
                baseTableName="guide_languages"
                baseColumnNames="language_id"
                constraintName="fk_guide_languages_language"
                referencedTableName="languages"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

        <addForeignKeyConstraint
                baseTableName="guide_languages"
                baseColumnNames="guide_id"
                constraintName="fk_guide_languages_guide"
                referencedTableName="guide"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />
    </changeSet>
</databaseChangeLog>