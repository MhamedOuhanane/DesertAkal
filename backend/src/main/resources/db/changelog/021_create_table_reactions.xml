<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="021" author="mhamed">
        <createTable tableName="reactions">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="uuid" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="reaction" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="article_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="reactions"
                baseColumnNames="article_id"
                constraintName="fk_reactions_article"
                referencedTableName="reactions"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

    </changeSet>
</databaseChangeLog>