<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="023" author="mhamed">
        <createTable tableName="email_verification_tokens">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="expires_at" type="TIMESTAMP" defaultValueComputed="NOW() + INTERVAL '30 days'">
                <constraints nullable="false"/>
            </column>

            <column name="used" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                baseTableName="email_verification_tokens"
                baseColumnNames="user_id"
                constraintName="fk_email_verification_tokens_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

    </changeSet>
</databaseChangeLog>