<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="036" author="mhamed">
        <dropColumn tableName="payments" columnName="transaction_id" />
        <addColumn tableName="payments">
            <column name="gateway_payment_id" type="VARCHAR(255)">
                <constraints unique="true" />
            </column>
            <column name="gateway_session_id" type="VARCHAR(255)" />
        </addColumn>
    </changeSet>

</databaseChangeLog>