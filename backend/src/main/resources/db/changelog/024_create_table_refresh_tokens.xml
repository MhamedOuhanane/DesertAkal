<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="024" author="mhamed">
        <createTable tableName="refresh_tokens">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="token" type="VARCHAR(500)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="family_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="parent_token" type="VARCHAR(500)"/>

            <column name="expires_at" type="TIMESTAMP" defaultValueComputed="NOW() + INTERVAL '30 days'">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

            <column name="used_at" type="TIMESTAMP"/>

            <column name="revoked_at" type="TIMESTAMP"/>

            <column name="used" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>

            <column name="revoked" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>

            <column name="reuse_detected" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>

            <column name="ip_address" type="VARCHAR(255)"/>

            <column name="user_agent" type="VARCHAR(255)"/>

            <column name="device_id" type="VARCHAR(36)"/>

            <column name="version" type="BIGINT"/>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <createIndex tableName="refresh_tokens" indexName="idx_token">
            <column name="token"/>
        </createIndex>

        <createIndex tableName="refresh_tokens" indexName="idx_family_id">
            <column name="family_id"/>
        </createIndex>

        <createIndex tableName="refresh_tokens" indexName="idx_user_family">
            <column name="user_id"/>
            <column name="family_id"/>
        </createIndex>

        <createIndex tableName="refresh_tokens" indexName="idx_user_device">
            <column name="user_id"/>
            <column name="device_id"/>
        </createIndex>

        <createIndex tableName="refresh_tokens" indexName="idx_family_active">
            <column name="family_id"/>
            <column name="revoked"/>
            <column name="used"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableName="refresh_tokens"
                baseColumnNames="user_id"
                constraintName="fk_refresh_tokens_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

    </changeSet>
</databaseChangeLog>