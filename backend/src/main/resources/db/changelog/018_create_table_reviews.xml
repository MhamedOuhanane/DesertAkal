<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="018" author="mhamed">
        <createTable tableName="reviews">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="uuid" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="rating" type="DECIMAL(3,2)">
                <constraints nullable="false"/>
            </column>

            <column name="comment" type="Text">
                <constraints nullable="false"/>
            </column>

            <column name="reviewable_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="reviewable_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="tourist_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <createIndex tableName="reviews" indexName="idx_reviews_target">
            <column name="reviewable_type"/>
            <column name="reviewable_id"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableName="reviews"
                baseColumnNames="tourist_id"
                constraintName="fk_reviews_tourist"
                referencedTableName="tourists"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

    </changeSet>
</databaseChangeLog>