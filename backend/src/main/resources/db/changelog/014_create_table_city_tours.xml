<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">


    <changeSet id="014" author="mhamed">
        <createTable tableName="city_tours">

            <column name="city_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="tour_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="order_index" type="INT">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addPrimaryKey
                tableName="city_tours"
                columnNames="city_id,tour_id"
                constraintName="pk_city_tours"
        />

        <addForeignKeyConstraint
                baseTableName="city_tours"
                baseColumnNames="tour_id"
                constraintName="fk_city_tours_tour"
                referencedTableName="tours"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

        <addForeignKeyConstraint
                baseTableName="city_tours"
                baseColumnNames="city_id"
                constraintName="fk_city_tours_city"
                referencedTableName="cities"
                referencedColumnNames="id"
                onDelete="CASCADE"
        />

    </changeSet>
</databaseChangeLog>